# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/zola

# Auth (required) - single-user, self-hosted login
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me
AUTH_SECRET=your_32_character_random_string

# Encryption key for BYOK provider keys stored at rest (32 bytes, base64)
ENCRYPTION_KEY=your_base64_32_byte_key

# CSRF Protection (required; also used to derive AUTH_SECRET if unset)
CSRF_SECRET=your_32_character_random_string

# AI Model API Keys
OPENAI_API_KEY=sk-your_openai_api_key
MISTRAL_API_KEY=your_mistral_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
XAI_API_KEY=your_xai_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Ollama Configuration (for local AI models)
OLLAMA_BASE_URL=http://localhost:11434

# Developer Tools (optional)
EXA_API_KEY=your_exa_api_key
GITHUB_TOKEN=your_github_token

# Production Configuration (optional)
NEXT_PUBLIC_VERCEL_URL=your_production_domain

# Development Tools (optional)
ANALYZE=false

# Shell / branding (optional, see lib/config.ts)
NEXT_PUBLIC_APP_NAME=Zola
# JSON array of id/name/model objects for the header agent picker
NEXT_PUBLIC_AGENTS=[{"id":"hermes","name":"Hermes Agent"}]
# Comma-separated model ids shown in the chat model picker (default: lib/config.ts ALLOWED_MODEL_IDS)
NEXT_PUBLIC_ALLOWED_MODELS=

# Cloud9 pages (Agents/Connectors/Scheduled/Board/Observe/Settings)
HERMES_DASHBOARD_URL=https://hermes.kryos.dev
HERMES_DASHBOARD_USER=praveen
HERMES_DASHBOARD_PASSWORD=
LITELLM_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=

# OpenCode coder-agent runtime (opencode serve), see lib/opencode/**
OPENCODE_URL=https://opencode.kryos.dev
OPENCODE_SERVER_PASSWORD=
OPENCODE_PROVIDER_ID=litellm
